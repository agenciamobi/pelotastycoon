# Normalize text files to LF to avoid Windows/Unity line-ending churn
* text=auto eol=lf

# Source/config text
*.cs text eol=lf
*.shader text eol=lf
*.hlsl text eol=lf
*.cginc text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.controller text eol=lf
*.anim text eol=lf

# Common binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.psd binary
*.tga binary
*.fbx binary
*.blend binary
*.wav binary
*.mp3 binary
*.ogg binary
*.mp4 binary
*.mov binary
*.ttf binary
*.otf binary

# Git LFS rules will be added deliberately when heavy licensed assets enter the project.
